- tab = 'power_generation'

= turbo_frame_tag "community_tab_content", class: "d-flex flex-column h-100" do  
  = render 'shared/jump_links', links: community_power_generation_jump_links(@community)
  
  .scrollspy-container.flex-grow-1.overflow-y-auto{ data: { controller: "scrollspy", bs_spy: "scroll", bs_target: "#jump-links", bs_smooth_scroll: "true" }, tabindex: "0" }
    - if @community.utilities?
      #utilities.scroll-section.mb-5
        = render 'shared/section_header',
          icon: 'buildings',
          title: 'Utilities',
          description: 'Electrical providers, service areas, and grid infrastructure',
          anchor: '#utilities',
          about_modal_id: 'utilitiesAboutModal' # this id must match the id in the sections about_modal partial

        = render "communities/#{tab}/utilities/about_modal"
        = render "communities/#{tab}/utilities"

    - if @community.generation?
      #generation.scroll-section.mb-5
        = render 'shared/section_header',
          icon: 'building-gear',
          title: 'Generation',
          description: 'Energy generation trends and fuel source mix',
          anchor: '#generation',
          related_metadata: ["public_monthly_generation", "public_yearly_generation"],
          about_modal_id: 'generationAboutModal' # this id must match the id in the sections about_modal partial

        = render "communities/#{tab}/generation/about_modal"
        = render "communities/#{tab}/generation"

    - if @community.capacities?
      #capacity.scroll-section.mb-5
        = render 'shared/section_header',
          icon: 'lightning-fill',
          title: 'Capacity',
          description: 'Installed infrastructure and maximum power output',
          anchor: '#capacity',
          related_metadata: ["public_capacity"],
          about_modal_id: 'capacityAboutModal' # this id must match the id in the sections about_modal partial

        = render "communities/#{tab}/capacity/about_modal"
        = render "communities/#{tab}/capacity"

    .mt-auto.overflow-hidden
      = render "shared/footer"
