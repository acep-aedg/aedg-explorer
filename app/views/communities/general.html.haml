- tab = 'general'

= turbo_frame_tag "community_tab_content", class: "d-flex flex-column h-100"  do
  = render 'shared/jump_links', links: community_general_jump_links(@community)
  .scrollspy-container.flex-grow-1.overflow-y-auto{ data: { controller: "scrollspy", bs_spy: "scroll", bs_target: "#jump-links", bs_smooth_scroll: "true" }, tabindex: "0" }
    #geography.scroll-section.mb-5
      = render 'shared/section_header',
        icon: 'globe',
        title: 'Geography',
        description: 'Location and regional associations',
        anchor: '#geography',
        related_metadata: ["public_communities"]

      = render "communities/#{tab}/geography"

    - if @community.transportation?
      #transportation.scroll-section.mb-5
        = render 'shared/section_header',
            icon: 'car-front',
            title: 'Transportation',
            description: 'Transit infrastructure and community mobility',
            anchor: '#transportation',
            related_metadata: ["public_transportation"]

        = render "communities/#{tab}/transportation"

    - if @community.legislative_districts?
      #legislative-districts.scroll-section.mb-5
        = render 'shared/section_header',
            icon: 'map',
            title: 'Legislative Districts',
            description: 'State representation and map boundaries',
            anchor: '#legislative-districts'

        = render "communities/#{tab}/legislative_districts"

    .mt-auto.overflow-hidden
      = render "shared/footer"
