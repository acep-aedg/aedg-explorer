- base_title = "#{@community.name} - Generation by Energy Source"

.chart-wrapper{ style: "height: 500px; width: 100%;" }
  %canvas{ 
    data: { 
      controller: "charts--yearly-generation",
      charts__yearly_generation: {
        url_value: generation_yearly_community_charts_path(@community),
        title_value: base_title 
      }
    } 
  }   