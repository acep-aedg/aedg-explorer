- base_title = "#{@community.name.titleize} - Energy Generation Profile"
- years          = @community.monthly_generations.available_years
- selected_year  = params[:year].presence&.to_i || years.first
- chart_id = "monthly-prod-chart"

#monthly-generation-chart-wrapper{
  data: {
    controller: "widget-update",
    widget_update: {
      charts_value: [
        { 
          id: chart_id, 
          url: generation_monthly_community_charts_path(@community),
          baseTitle: base_title,
          param: 'year'
        }
      ].to_json
    }
  }
}
  - if years.size > 1
    .d-flex.align-items-center.gap-2.mb-2
      %label.form-label.me-2.mb-0{ for: "monthly-generation-year" } Year:

      %select#monthly-generation-year.form-select.form-select-sm.w-auto{
        data: { action: "change->widget-update#update" }
      }
        - years.each do |y|
          %option{ value: y, selected: y == selected_year }= y

  = column_chart generation_monthly_community_charts_path(@community, year: selected_year),
    height: '400px',
    id: chart_id,
    title: "#{base_title} (#{selected_year})",
    xtitle: 'Month',
    download: {filename: base_title.parameterize},
    colors: [color(:blue), color(:orange)],
    library: { scales: { y: { type: "linear", position: "left", title: { text: "Generation (MWh)" } }, y1: { type: "linear", display: "auto", position: "right", title: { text: "Heating Degree Days" } } } }