- parent_tab = 'general'

.section-body.m-1.m-md-2.m-lg-4.mt-3
  / Map Buttons
  = render 'shared/map_buttons', buttons: community_legislative_map_buttons(@community)
  
  / Sub-sections for District Data
  .row.g-4
    - if @community.house_districts?
      .col-12.col-lg-6
        .p-3.border.rounded-3.h-100.shadow-sm
          .d-flex.align-items-center.mb-3.border-bottom.pb-2
            %i.bi.bi-table.me-2.text-primary
            %h5.mb-0.fw-bold House Districts
          = render "communities/#{parent_tab}/legislative_districts/house_district_data"

    - if @community.senate_districts?
      .col-12.col-lg-6
        .p-3.border.rounded-3.h-100.shadow-sm
          .d-flex.align-items-center.mb-3.border-bottom.pb-2
            %i.bi.bi-table.me-2.text-primary
            %h5.mb-0.fw-bold Senate Districts
          = render "communities/#{parent_tab}/legislative_districts/senate_district_data"