%nav#summary-toolbar.bg-white.p-2.border-bottom{ aria: { label: "Entity Navigation" } }
  .d-flex.justify-content-between.align-items-center.gap-2
    .d-flex.align-items-center.gap-2.flex-shrink-0
      %i.bi.bi-geo-alt-fill.text-primary.fs-5{ aria: { hidden: "true" } }
      .d-flex.align-items-baseline.flex-wrap.gap-2
        %h1.fw-bold.fs-5.lh-sm.mb-0= entity.try(:long_name) || entity

        - if entity.is_a?(Community)
          .d-flex.align-items-center.flex-wrap.gap-1.text-muted.small
            - if entity.borough.present?
              = link_to entity.borough.name, borough_path(entity.borough),
                class: "text-info",
                target: "_blank", rel: "noopener",
                data: { turbo_frame: "_top" },
                aria: { label: "#{entity.borough.name} (opens in new window)" }

              - if entity.grid.present?
                %span.opacity-50{ aria: { hidden: "true" } } &bull;

            - if entity.grid.present?
              = link_to entity.grid.name, grid_path(entity.grid),
                class: "text-info",
                target: "_blank", rel: "noopener",
                data: { turbo_frame: "_top" },
                aria: { label: "Grid: #{entity.grid.name} (opens in new window)" }

    .flex-shrink-0
      = render "shared/dropdown", collection: collection, size_class: "form-select-sm"
