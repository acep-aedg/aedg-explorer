- content_for :hide_global_footer, "true"
- content_for :title, page_title(@parents, @parent)
- content_for :content do
  -# maps and split layout controller
  .dashboard-viewport{ data: mapbox_api_data({ maps_default_layer_id_value: default_map_layer }).merge({ controller: "maps split-layout" }) }
    .top-section{ data: { split_layout_target: "top" } }
      = render "shared/toolbar",
        entity: @parent,
        collection: @parents,
        tabs: grouped_summaries_navigation_tabs(@parent),
        target_frame: "tab_content"

    .split-wrapper
      -# Map (Left Side)
      .d-none.d-lg-block.split-left{ data: { split_layout_target: "left" } }
        = render 'grouped_summaries/map_sidebar'

      -# user moves to increase or decrease widths
      .split-gutter.d-none.d-lg-flex{ data: { split_layout_target: "gutter" } }

      -# Right Side Content
      .split-right.d-flex.flex-column.h-100{ data: { split_layout_target: "right", controller: "scroll", action: "turbo:frame-render->scroll#scrollToTop" } }
        = render "shared/main_tabs",
            tabs: grouped_summaries_navigation_tabs(@parent),
            target_frame: "tab_content"

        .flex-grow-1.d-flex.flex-column.overflow-hidden
          = turbo_frame_tag "tab_content" do
            = yield

= render template: "layouts/application"
